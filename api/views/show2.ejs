<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My CRUD in NodeJS</title>
</head>

<body>
    <h2>Registros</h2>
    <table border="1">
        <thead>
            <tr>
                <td>nome</td>
                <td>email</td>
                <td>telefone</td>
            </tr>
        </thead>
        <tbody>
            <% crud.forEach(function(details) { %>
                <tr>
                    <td>
                        <%= details.nome %>
                    </td>
                    <td>
                        <%= details.email %>
                    </td>
                    <td>
                        <%= details.telefone %>
                    </td>
                    <td><a href="/edit2/<%= details._id %>">Editar</a> - <a href="/delete2/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table> <button><a href="/index2">Novo</a></button>
</body>

</html>