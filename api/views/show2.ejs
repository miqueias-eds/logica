<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
    <title>SafeMídia</title>

    <style>

    .bree-serif-regular {
    font-family: "Bree Serif", serif;
    font-weight: 400;
    font-style: normal; }
     


    .corpo {
    background-color: #CBE6FF;
    font-family: "Bree Serif", serif; }

    .regist {
        text-align: center;
        font-size: 50px;
        color: #25678E;
    }

    .tabela {
        width: fit-content;
        margin: 0 auto;
        border-radius: 10px;
        
    }

    .botao {
    /* Aparência */
    background-color: #0E4F7F;
    color: white;
    border: 1px solid #104B6E;
    border-radius: 10px;

    /* Dimensões */
    width: 90px;
    height: 45px;
    box-sizing: border-box;

    /* Alinhamento do texto */
    display: flex;
    align-items: center;
    justify-content: center;

    /* Centralização horizontal do botão */
    margin: 20px auto 0;

    /* Texto */
    font-family: "Bree Serif", serif;
    font-size: 18px;
    text-decoration: none;

    cursor: pointer;
    transition: background-color 0.3s; }

    /* Efeito ao passar o mouse */
    .botao:hover {
    background-color: #25678E; }

    </style>
</head>

<body class="corpo">
    <h2 class="regist">Registros</h2>
    <table class="tabela" border="1">
        <thead>
            <tr style="font-size: 30px; text-align: center; color: #25678E;">
                <td>Nome</td>
                <td>CPF</td>
                <td>Email</td>
                <td>Telefone</td>
                <td>Gênero</td>
                <td>Senha</td>
                <td>Opções</td>
            </tr>
        </thead>
        <tbody style="font-size: 25px;">
            <% crud.forEach(function(details) { %>
                <tr>
                    <td>
                        <%= details.nome %>
                    </td>
                    <td>
                        <%= details.cpf %>
                    </td>
                    <td>
                        <%= details.email %>
                    </td>
                    <td>
                        <%= details.telefone %>
                    </td>
                    <td>
                        <%= details.genero %>
                    </td>
                    <td>
                        ••••••••
                    </td>
                    <td><a href="/edit2/<%= details._id %>">Editar</a> - <a href="/delete2/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table> 
    
    <a class="botao" href="/index2">Novo</a>

</body>

</html>