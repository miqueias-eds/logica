<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>SafeMídia</title>
</head>

<body>
    <h2 style="margin-left: 500px;">Registros</h2>
    <table style="margin-left: 380px;" border="1">
        <thead>
            <tr style="font-size: 20px;">
                <td>nome</td>
                <td>cpf</td>
                <td>email</td>
                <td>telefone</td>
                <td>genero</td>
                <td>senha</td>
            </tr>
        </thead>
        <tbody style="font-size: 20px;">
            <% crud.forEach(function(details) { %>
                <tr>
                    <td>
                        <%= details.nome %>
                    </td>
                    <td>
                        <%= details.cpf %>
                    </td>
                    <td>
                        <%= details.email %>
                    </td>
                    <td>
                        <%= details.telefone %>
                    </td>
                    <td>
                        <%= details.genero %>
                    </td>
                    <td>
                        <%= details.senha %>
                    </td>
                    <td><a href="/edit2/<%= details._id %>">Editar</a> - <a href="/delete2/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table> <button style="color: black; border-color: rgb(13, 64, 108); border-radius: 10px; width: 70px; height: 36px; background-color: rgb(87, 160, 255); font-size: 20px; margin-left: 510px; margin-top: 25px; "><a style="color: black;" href="/index2">Novo</a></button>
</body>

</html>