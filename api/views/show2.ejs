<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>SafeMídia</title>
</head>

<body>
    <h2 style="margin-left: 220px;">Registros</h2>
    <table border="1">
        <thead>
            <tr style="font-size: 20px;">
                <td style="color: red;">nome</td>
                <td style="color: red;">email</td>
                <td style="color: red;">telefone</td>
                <td style="color: red;">Opções</td>
            </tr>
        </thead>
        <tbody style="font-size: 20px;">
            <% crud.forEach(function(details) { %>
                <tr>
                    <td>
                        <%= details.nome %>
                    </td>
                    <td>
                        <%= details.cpf %>
                    </td>
                    <td>
                        <%= details.email %>
                    </td>
                    <td>
                        <%= details.telefone %>
                    </td>
                    <td>
                        <%= details.genero %>
                    </td>
                    <td>
                        <%= details.senha %>
                    </td>
                    <td><a href="/edit2/<%= details._id %>">Editar</a> - <a href="/delete2/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table> <button style="color: rgb(0, 0, 0); border-color: rgb(5, 73, 0); border-radius: 10px; width: 70px; height: 36px; background-color: rgb(12, 194, 2); font-size: 20px; margin-left: 230px; margin-top: 25px; "><a style="color: black;" href="/index2">Novo</a></button>
</body>

</html>