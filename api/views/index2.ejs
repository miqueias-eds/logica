<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
    <style>

        .bree-serif-regular {
        font-family: "Bree Serif", serif;
        font-weight: 400;
        font-style: normal; }

        .cadtitle {
            font-family: "Bree Serif", serif;
            font-size: 36px;
            color: #25678E;
            text-align: center;
        }

        
        .formulario {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center; }

        .digitenome {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px #25678E, solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px; }

        .digitenome::placeholder {
                text-align: center;
                font-size: 20px;
                color:#25678E;
                opacity: 50%; }

        .CpF {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px #25678E solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px; }

        .CpF::placeholder {
                text-align: center;
                font-size: 20px;
                color:#25678E;
                opacity: 50%;
                }

         .EmAil {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px #25678E, solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px; }

            .EmAil::placeholder {
            text-align: center;
            font-size: 20px;
            color:#25678E;
            opacity: 50%; }

            .telf {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px #25678E, solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px; }

            .telf::placeholder {
            text-align: center;
            font-size: 20px;
            color:#25678E;
            opacity: 50%; }

            .gen {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px solid #25678E;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px;}

            .gen::placeholder {
            text-align: center;
            font-size: 20px;
            color:#25678E;
            opacity: 50%; }

            .sen {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border: 2px solid #25678E;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px;
            text-align: center;
            font-size: 20px;}

            .sen::placeholder {
                text-align: center;
                font-size: 20px;
            color:#25678E;
                opacity: 50%; }

            .botaocadastrese {
                background: #0E4F7F;
                border: 2px solid #104B6E;
                border-radius: 15px;
                color: white;
                font-family: "Bree Serif", serif;
                margin-top: 10px;
                width: 150px;
                height: 40px;
                font-size: 15px;
                cursor: pointer;
            }

            .ncos{
                margin: 0;
                margin-right: 38px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .cpftitle{
                margin: 0;
                margin-right: 260px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .emailtitle{
                margin: 0;
                margin-right: 260px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .teltitle{
                margin: 0;
                margin-right: 220px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .gentitle{
                margin: 0;
                margin-right: 245px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .senhatitle{
                margin: 0;
                margin-right: 238px;
            color: #25678E;
            font-family: "Bree Serif", serif;}

            .back{
            background: white;
            border: 2px solid #104B6E;
            border-radius: 10px;
            color: #25678E;
            font-family: "Bree Serif", serif;
            margin-top: 10px;
            width: 70px;
            height: 22px;
            font-size: 15px;
            cursor: pointer;
            text-align: center; }

    </style>
</head>

<body style="background-color: #CBE6FF;">
    <h2 class="cadtitle">CADASTRO<h2>
    <div>
        <form class="formulario" action="/show2" method="POST">
        <h4 class="ncos">Nome completo ou social *</h4>
        <input class="digitenome" type="text" placeholder="Insira seu nome completo ou social" name="nome">
        <h4 class="cpftitle">CPF *</h4>
        <input class="CpF" type="number" placeholder="000.000.000-00" name="cpf">
        <h4 class="emailtitle">Email</h4>
        <input class="EmAil" type="email" placeholder="exemplo@email.com" name="email">
        <h4 class="teltitle">Telefone *</h4>
        <input class="telf" type="tel" placeholder="(00) 0.0000-0000" name="telefone">
        <h4 class="gentitle">Gênero</h4>
        <input class="gen" type="text" placeholder="Selecione seu gênero" name="genero">
        <h4 class="senhatitle">Senha *</h4>
        <input class="sen" type="password" placeholder="Mínimo 6 caracteres" name="senha">
        
                    
        <button class="botaocadastrese" type="submit">CADASTRAR-SE</button>
        <a class="back" style="text-decoration: none;" href="/show2">Voltar</a>
    </form>
    </div>
</body>

</html>