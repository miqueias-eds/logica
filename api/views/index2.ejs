<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet">
    <style>

        .bree-serif-regular {
        font-family: "Bree Serif", serif;
        font-weight: 400;
        font-style: normal; }

        .cadtitle {
            font-family: "Bree Serif", serif;
            font-size: 36px;
            color: #25678E;
            text-align: center;
        }

        
        .formulario {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center; }

        .digitenome {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E, solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px; }

        .digitenome::placeholder {
                text-align: center;
                font-size: 20px; }

        .CpF {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E, solid;
            font-family: "Bree Serif", serif; }

        .CpF::placeholder {
                text-align: center;
                font-size: 20px; }

         .EmAil {
            border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E, solid;
            font-family: "Bree Serif", serif;
            margin-bottom: 10px; }

            .EmAil::placeholder {
                text-align: center;
                font-size: 20px; }

            .telf {
                border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E, solid;
            font-family: "Bree Serif", serif;
            }

            .gen {
                border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E;
            font-family: "Bree Serif", serif;
            }

            .sen {
                border-radius: 30px;
            width: 342px;
            height: 25px;
            background-color: #A3D3FF;
            border-color: #25678E;
            font-family: "Bree Serif", serif;
            }

            .botaocadastrese {
                background: #0E4F7F;
                border-color: #104B6E;
                border-radius: 15px;
                color: white;
                font-family: "Bree Serif", serif;
                margin-top: 10px;
            }

            .ncos{
                margin: 0;
                margin-right: 70px;
            }

            .cpftitle{
                margin: 0;
                margin-right: 260px;
            }

            .emailtitle{
                margin: 0;
                margin-right: 260px;
            }

            .teltitle{
                margin: 0;
                margin-right: 220px;
            }

    </style>
</head>

<body style="background-color: #CBE6FF;">
    <h2 class="cadtitle">CADASTRO<h2>
    <div>
        <form class="formulario" action="/show2" method="POST">
        <h4 class="ncos">Nome completo ou social</h4>
        <input class="digitenome" type="text" placeholder="Insira seu nome completo ou social" name="nome">
        <h4 class="cpftitle">CPF *</h4>
        <input class="CpF" type="number" placeholder="000.000.000-00" name="cpf">
        <h4 class="emailtitle">Email</h4>
        <input class="EmAil" type="email" placeholder="exemplo@email.com" name="email">
        <h4 class="teltitle">Telefone *</h4>
        <input class="telf" type="tel" placeholder="(00) 0.0000-0000" name="telefone">
        <h4>Gênero</h4>
        <input class="gen" type="text" placeholder="Selecione seu gênero" name="genero">
        <h4>Senha</h4>
        <input class="sen" type="password" placeholder="Mínimo 6 caracteres" name="senha">
        
                    
        <button class="botaocadastrese" type="submit">CADASTRAR-SE</button>
    </form>
    </div>
</body>

</html>