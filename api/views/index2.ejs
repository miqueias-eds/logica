<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My CRUD in NodeJS</title>
</head>

<body>
    <h2>Registrar<h2>
    <form action="/show2" method="POST"> 
        <input type="text" placeholder="Nome" name="nome"> 
        <input type="number" placeholder="cpf" name="cpf">
        <input type="email" placeholder="email" name="email">
        <input type="tel" placeholder="telefone" name="telefone">
        <input type="text" placeholder="genero" name="genero">
        <input type="password" placeholder="senha" name="senha">
        
                    
        <button type="submit">Submit</button>
    </form>
</body>

</html>