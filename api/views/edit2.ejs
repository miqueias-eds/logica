    </head>

    <body style="background-color: #CBE6FF;">
        <div>
            <h2 class="titulo">Editar dados</h2>
        <% crud.forEach(function(details) { %>
            <form class="container" action="/edit2/<%= details._id %>" method="POST">
                <h4 class="ncos">Nome completo ou social *</h4>
                <input class="digitenome" type="text" placeholder="Nome" value="<%= details.nome %>" name="nome">
                <h4 class="cpftitle">CPF *</h4>
                <input class="CpF" type="text" placeholder="CPF" value="<%= details.cpf %>" name="cpf">
                <h4 class="emailtitle">Email</h4>
                <input class="EmAil" type="text" placeholder="Email" value="<%= details.email %>" name="email">
                <h4 class="teltitle">Telefone *</h4>
                <input class="telf" type="text" placeholder="Telefone" value="<%= details.telefone %>" name="telefone">
                <h4 class="gentitle">Gênero</h4>
                <input class="gen" type="text" placeholder="Gênero" value="<%= details.genero %>" name="genero">
                <h4 class="senhatitle">Senha *</h4>
                <input class="sen" type="password" placeholder="Senha" value="<%= details.senha %>" name="senha">
                <br/>
                <button class="savechanges" style="cursor: pointer;" type="submit">
                    Salvar alterações
                </button>
                
                <a class="back" style="text-decoration: none;" href="/show2">Voltar</a>
                
            </form>
        <% }) %>
        </div>
    </body>

</html>